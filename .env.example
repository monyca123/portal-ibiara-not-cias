PORT=3000

# Chave usada para assinar os tokens de login (JWT). Gere uma forte em
# producao, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-e-longa

# Preencha depois de criar as credenciais em https://console.cloud.google.com/
# (necessario para o login "Continuar com Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
